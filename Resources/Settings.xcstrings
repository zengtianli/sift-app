    "External volumes, cloud caches, and temporary folders are excluded by default. Invalid root folders and relative paths are rejected, keeping the existing scope." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External volumes, cloud caches, and temporary folders are excluded by default. Invalid root folders and relative paths are rejected, keeping the existing scope."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认跳过外接卷、云缓存和临时目录。相对路径或错误根目录会拒绝保存，原范围保留。"
          }
        }
      }
