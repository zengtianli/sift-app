    },
    "Saves changes when needed. If disabled, changes are still saved when Sift quits." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves changes when needed. If disabled, changes are still saved when Sift quits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有变化时按需保存；关闭后仍在退出时保存。"
          }
        }
      }
    },
    "Choose folders using the system dialog to grant access. Login items are managed by macOS and do not transfer with settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose folders using the system dialog to grant access. Login items are managed by macOS and do not transfer with settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过系统文件夹选择面板授予搜索范围；登录项由 macOS 管理，不随配置迁移。"
          }
        }
      }
    },
    "Check the allowed folders, exclusions, and index status. Choose the folder again or rebuild the index manually." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the allowed folders, exclusions, and index status. Choose the folder again or rebuild the index manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查授权文件夹、排除规则和索引状态；可重新选择文件夹或手动重建。"
          }
        }
      }
    },
    "Requires Apple silicon and macOS 14 or later. Updates come from the App Store. Settings sync, import, and export are below." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires Apple silicon and macOS 14 or later. Updates come from the App Store. Settings sync, import, and export are below."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon，macOS 14+。通过 App Store 更新；配置同步和导入/导出在本窗口下方。"
          }
        }
      }
    },
    "The index and search history stay on this Mac. Optional iCloud sync transfers settings only. Updates come from the App Store." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The index and search history stay on this Mac. Optional iCloud sync transfers settings only. Updates come from the App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索引和搜索历史留在本机，可选 iCloud 仅同步配置。通过 App Store 更新。"
          }
        }
      }
    },
    "Saves changes when needed. If disabled, changes are still saved when Sift quits. Run sift flush to save manually." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves changes when needed. If disabled, changes are still saved when Sift quits. Run sift flush to save manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有变化时按需保存；关闭后仍在退出时保存，可用 sift flush 手动保存。"
          }
        }
      }
    },
    "Full Disk Access and login items are managed by macOS and do not transfer with settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Disk Access and login items are managed by macOS and do not transfer with settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全磁盘访问和登录项由 macOS 管理，不随配置迁移。"
          }
        }
      }
    },
    "Check the search scope, exclusions, pause status, permissions, and incomplete index warnings. Review diagnostics or rebuild manually. Protected folders require Full Disk Access." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the search scope, exclusions, pause status, permissions, and incomplete index warnings. Review diagnostics or rebuild manually. Protected folders require Full Disk Access."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查范围/排除、暂停状态、权限和不完整索引提示；可查看诊断或手动重建。保护目录需要完全磁盘访问。"
          }
        }
      }
    },
    "Requires Apple silicon and macOS 14 or later. Updates, optional settings sync, import, and export are below. The index and system permissions do not transfer with settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires Apple silicon and macOS 14 or later. Updates, optional settings sync, import, and export are below. The index and system permissions do not transfer with settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon，macOS 14+。软件更新、可选配置同步和导入/导出在本窗口下方；索引与系统权限不随配置迁移。"
          }
        }
      }
    },
    "The file index, paths, and search history stay on this Mac. File contents are never uploaded. Selected settings sync only when you enable iCloud. Checking for updates only reads Sift's public release record on GitHub. Diagnostics omit search scope paths and history by default." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file index, paths, and search history stay on this Mac. File contents are never uploaded. Selected settings sync only when you enable iCloud. Checking for updates only reads Sift's public release record on GitHub. Diagnostics omit search scope paths and history by default."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件索引、路径与搜索历史保存在本机，不上传文件内容。只有主动开启 iCloud 时同步选定配置；检查更新只读取 GitHub 上 Sift 公开发行的发行记录。诊断默认不含范围路径和搜索历史。"
          }
        }
      }
    },
